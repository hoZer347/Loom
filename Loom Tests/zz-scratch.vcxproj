  <ItemGroup>
    <!-- The engine sources under test are compiled straight into the test
         binary rather than linked from Loom WASM.lib, so the suite keeps
         building while other parts of that project are mid-refactor. The web
         build reads this same list back out of this file and hands it to
         emcc, so both builds cover exactly the same code.
         Wildcards rather than a fixed list: files come and go in Loom WASM
         often enough that a hand-maintained copy would be stale within a day.
         Nothing here constructs an Engine, so no window and no GL context is
         ever created; the tests drive the parts that do not need one. -->
    <ClCompile Include="..\Loom WASM\*.cpp" />
    <ClCompile Include="..\Loom WASM\Utilities\*.cpp" Exclude="..\Loom WASM\Utilities\_*.cpp" />
  </ItemGroup>
  <ItemGroup>
    <!-- The editor's undo history and edit shortcuts, the parts of it that do
         not need a window. The rest of the editor stays out. -->
    <ClCompile Include="C:\Users\3hoze\AppData\Local\Temp\claude\c--Users-3hoze-Desktop-Loom\59bd1eca-9dd7-41a3-a7ea-2611eaf6cdaa\scratchpad\mut\SceneHistory.cpp" />
    <ClCompile Include="C:\Users\3hoze\AppData\Local\Temp\claude\c--Users-3hoze-Desktop-Loom\59bd1eca-9dd7-41a3-a7ea-2611eaf6cdaa\scratchpad\mut\EditCommands.cpp" />
  </ItemGroup>
  <ItemGroup>
    <!-- ImGui is linked rather than recompiled: Component<T>::Gui and
         GameObject::Gui call into it, and it builds cleanly as a library. -->
    <ProjectReference Include="..\Loom ImGui\Loom ImGui.vcxproj">
      <Project>{d58e30f6-a1a0-4a69-a043-d8d4cd47e0b8}</Project>
    </ProjectReference>
  </ItemGroup>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.targets" />
  <Target Name="CopyRuntimeDependencies" AfterTargets="Build">
    <!-- The suite never calls into GLEW, but it links glew32.lib through
         OpenGL.props, so the loader still wants glew32.dll beside the
         executable. Without this the binary dies with STATUS_DLL_NOT_FOUND
         before main runs, in whichever configuration has not had the DLL
         dropped in by some other project. -->
    <Copy SourceFiles="$(DevDirectory)\glew\bin\Release\x64\glew32.dll"
          DestinationFolder="$(OutDir)"
          SkipUnchangedFiles="true"
          Condition="Exists('$(DevDirectory)\glew\bin\Release\x64\glew32.dll')" />
  </Target>
