<?xml version="1.0" encoding="utf-8"?>
<!-- A game on its own: the engine and a project's scripts linked into one
     program. build-game.ps1 builds it with SolutionDir naming the engine,
     which the property sheets and the engine's own projects need,
     GameScripts the project's scripts folder, GameBuild the project's Build
     folder, under which it goes in a folder for each configuration before
     the script copies it out, and GameName what it is called. In the
     solution, with no Game property given, it is the player with no
     scripts. -->
<Project DefaultTargets="Build" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <ItemGroup Label="ProjectConfigurations">
    <ProjectConfiguration Include="Debug|x64">
      <Configuration>Debug</Configuration>
      <Platform>x64</Platform>
    </ProjectConfiguration>
    <ProjectConfiguration Include="Release|x64">
      <Configuration>Release</Configuration>
      <Platform>x64</Platform>
    </ProjectConfiguration>
    <ProjectConfiguration Include="Final|x64">
      <Configuration>Final</Configuration>
      <Platform>x64</Platform>
    </ProjectConfiguration>
  </ItemGroup>
  <PropertyGroup Label="Globals">
    <VCProjectVersion>18.0</VCProjectVersion>
    <Keyword>Win32Proj</Keyword>
    <ProjectGuid>{2be059e3-b034-458d-9138-9e5bc5ad8888}</ProjectGuid>
    <RootNamespace>LoomPlayer</RootNamespace>
    <WindowsTargetPlatformVersion>10.0</WindowsTargetPlatformVersion>
    <ProjectName>Loom Player</ProjectName>
  </PropertyGroup>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.Default.props" />
  <PropertyGroup Label="Configuration">
    <ConfigurationType>Application</ConfigurationType>
    <PlatformToolset>v145</PlatformToolset>
    <CharacterSet>Unicode</CharacterSet>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)'=='Debug'" Label="Configuration">
    <UseDebugLibraries>true</UseDebugLibraries>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)'!='Debug'" Label="Configuration">
    <UseDebugLibraries>false</UseDebugLibraries>
    <WholeProgramOptimization>true</WholeProgramOptimization>
  </PropertyGroup>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.props" />
  <ImportGroup Label="PropertySheets">
    <Import Project="$(UserRootDir)\Microsoft.Cpp.$(Platform).user.props" Condition="exists('$(UserRootDir)\Microsoft.Cpp.$(Platform).user.props')" Label="LocalAppDataPlatform" />
    <Import Project="..\Property Files\Loom WASM.props" />
    <Import Project="..\Property Files\Loom ImGui.props" />
    <Import Project="..\Property Files\OpenGL.props" />
    <Import Project="..\Property Files\Vulkan.props" />
    <Import Project="..\Property Files\UserMacros.props" />
  </ImportGroup>
  <PropertyGroup Condition="'$(GameBuild)'!=''">
    <OutDir>$(GameBuild)\Player\$(Configuration)\</OutDir>
    <IntDir>$(GameBuild)\Intermediate\Player\$(Configuration)\</IntDir>
  </PropertyGroup>
  <PropertyGroup Condition="'$(GameName)'!=''">
    <TargetName>$(GameName)</TargetName>
  </PropertyGroup>
  <ItemDefinitionGroup>
    <ClCompile>
      <WarningLevel>Level3</WarningLevel>
      <ConformanceMode>true</ConformanceMode>
      <LanguageStandard>stdcpplatest</LanguageStandard>
      <AdditionalOptions>/utf-8 %(AdditionalOptions)</AdditionalOptions>
      <PrecompiledHeader>Use</PrecompiledHeader>
      <PrecompiledHeaderFile>Loom.h</PrecompiledHeaderFile>
      <ForcedIncludeFiles>Loom.h;%(ForcedIncludeFiles)</ForcedIncludeFiles>
      <AdditionalIncludeDirectories>$(GameScripts);%(AdditionalIncludeDirectories)</AdditionalIncludeDirectories>
    </ClCompile>
    <Link>
      <SubSystem>Windows</SubSystem>
      <EntryPointSymbol>mainCRTStartup</EntryPointSymbol>
      <GenerateDebugInformation>true</GenerateDebugInformation>
      <AdditionalOptions>/WHOLEARCHIVE:"Loom WASM.lib" %(AdditionalOptions)</AdditionalOptions>
    </Link>
  </ItemDefinitionGroup>
  <ItemDefinitionGroup Condition="'$(Configuration)'=='Debug'">
    <ClCompile>
      <SDLCheck>true</SDLCheck>
      <PreprocessorDefinitions>_DEBUG;_WINDOWS;%(PreprocessorDefinitions)</PreprocessorDefinitions>
    </ClCompile>
    <Link>
      <IgnoreSpecificDefaultLibraries>msvcrt.lib;%(IgnoreSpecificDefaultLibraries)</IgnoreSpecificDefaultLibraries>
    </Link>
  </ItemDefinitionGroup>
  <ItemDefinitionGroup Condition="'$(Configuration)'!='Debug'">
    <ClCompile>
      <SDLCheck>true</SDLCheck>
      <FunctionLevelLinking>true</FunctionLevelLinking>
      <IntrinsicFunctions>true</IntrinsicFunctions>
      <PreprocessorDefinitions>NDEBUG;_WINDOWS;%(PreprocessorDefinitions)</PreprocessorDefinitions>
    </ClCompile>
    <Link>
      <LinkTimeCodeGeneration>UseLinkTimeCodeGeneration</LinkTimeCodeGeneration>
      <LinkTimeCodeGenerationObjectFile />
      <EnableCOMDATFolding>true</EnableCOMDATFolding>
      <OptimizeReferences>true</OptimizeReferences>
    </Link>
  </ItemDefinitionGroup>
  <!-- The engine's header precompiled once and forced into the player and
       each script, which is a header compiled on its own, as the scripts'
       own project compiles them. -->
  <ItemGroup>
    <ClCompile Include="..\Loom WASM\Loom.h">
      <CompileAs>CompileAsCpp</CompileAs>
      <PrecompiledHeader>Create</PrecompiledHeader>
      <ObjectFileName>$(IntDir)Loom.h.obj</ObjectFileName>
    </ClCompile>
    <ClCompile Include="Player.cpp" />
    <ClCompile Include="$(GameScripts)\**\*.hpp" Condition="'$(GameScripts)'!=''">
      <CompileAs>CompileAsCpp</CompileAs>
    </ClCompile>
  </ItemGroup>
  <!-- What the game is built from is the engine itself, not a copy for each
       game, so none of the Game properties is handed on to it. -->
  <ItemGroup>
    <ProjectReference Include="..\Loom ImGui\Loom ImGui.vcxproj">
      <Project>{d58e30f6-a1a0-4a69-a043-d8d4cd47e0b8}</Project>
      <GlobalPropertiesToRemove>GameScripts;GameBuild;GameName</GlobalPropertiesToRemove>
    </ProjectReference>
    <ProjectReference Include="..\Loom WASM\Loom Emscripten Testing.vcxproj">
      <Project>{7573054a-30a9-427c-87d0-7a2d67c22891}</Project>
      <GlobalPropertiesToRemove>GameScripts;GameBuild;GameName</GlobalPropertiesToRemove>
    </ProjectReference>
  </ItemGroup>
  <Import Project="..\Property Files\Final.props" Condition="'$(Configuration)'=='Final'" />
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.targets" />
  <Target Name="CopyRuntimeDependencies" AfterTargets="Build">
    <Copy SourceFiles="$(DevDirectory)\glew\bin\Release\x64\glew32.dll"
          DestinationFolder="$(OutDir)"
          SkipUnchangedFiles="true" />
  </Target>
</Project>
